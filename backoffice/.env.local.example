# Copie ce fichier en .env.local (jamais commité, voir .gitignore) et remplis
# les vraies valeurs depuis le dashboard Supabase du projet AFROBACK
# (Project Settings > API).

# URL du projet Supabase — la même que celle utilisée par l'app mobile.
NEXT_PUBLIC_SUPABASE_URL=https://ygkyapryramhaskfbrrt.supabase.co

# Clé publique "anon" — sert UNIQUEMENT à vérifier la session de connexion
# (qui est connecté), jamais à lire/écrire du contenu. Sans danger à exposer
# côté navigateur, comme dans l'app mobile.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — donne un accès complet à la base, en contournant RLS.
# ⚠️ SECRET. Ne JAMAIS préfixer par NEXT_PUBLIC_ (sinon elle serait envoyée
# au navigateur). Utilisée uniquement dans du code serveur (Server
# Components, Server Actions, Route Handlers) — voir lib/supabase/server.ts.
# Dashboard Supabase > Project Settings > API > "service_role" secret.
SUPABASE_SERVICE_ROLE_KEY=
