  "lines": [
    {"start": 1.2, "text": "Écoute."},
    {"start": 3.1, "text": "Ce jour-là, à Zama, un prince allait être couronné."},
    {"start": 7.4, "text": "Enzo Kori-Odan. Et sa fiancée, Erine."},
    {"start": 12.0, "text": "Mais, quelques instants avant le couronnement…"},
    {"start": 15.35, "text": "Trahison ! Le frère d'Erine s'empare du trône."},
    {"start": 21.0, "text": "Enzo est chassé de son propre palais."},
    {"start": 29.9, "text": "Alors il invoque l'Aurion, la force des ancêtres."},
    {"start": 35.0, "text": "Avec Erine, il part chercher des alliés dans d'autres nations."},
    {"start": 41.25, "text": "Pour reprendre son trône."},
    {"start": 47.0, "text": "À toi de vivre la légende. Joue à Aurion !"}
  ],
